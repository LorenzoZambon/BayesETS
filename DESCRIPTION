Package: BayesETS
Type: Package
Title: Forecasting using Bayesian ETS
Version: 0.1.0
Authors@R: c(
    person(
      given = "Lorenzo", 
      family = "Zambon",
      email = "lorenzo.zambon@supsi.ch",
      role = c("aut", "cre"),
      comment = c(ORCID = "0000-0002-8939-993X")
    )
